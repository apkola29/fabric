# Copy to .env and fill in. Never commit .env.
#
# No credentials belong in this file. Whatever is secret is asked for when the app starts ("npm start",
# "npm run setup", the CLI and the validator), with hidden input, and used for that run only:
#   - the platform identity's certificate or client secret (FABRIC_AUTH_MODE=sp)
#   - SECRETS_KEY, which unlocks the customers' stored credentials
#   - ADMIN_KEY, the back-office sign-in
# Without a terminal (CI, a hosted app), set them in the environment instead, or better, use a managed identity
# (MANAGED_IDENTITY_CLIENT_ID) and Key Vault (SECRETS_PROVIDER=keyvault) so there is nothing secret to set.

# mock = no Fabric calls (default) | cli = your `az login` identity | sp = service principal (client credentials)
FABRIC_AUTH_MODE=mock

# The platform identity (control plane): an app registration in your Entra tenant. Required for sp mode. Optional
# for cli mode (pins the tenant). IDs aren't secret, but keep your own out of anything you publish.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# How it signs in, best first (sp mode; give one, or leave all empty to be asked at start):
#   MANAGED_IDENTITY_CLIENT_ID     hosted in Azure: the client ID of a user-assigned managed identity that the app
#                                  registration trusts (a federated identity credential). Nothing secret anywhere.
#   AZURE_CLIENT_CERTIFICATE_PATH  a PEM file with the private key and certificate, kept outside this folder.
#   AZURE_CLIENT_SECRET            development only; production refuses it. Don't put it here: you're asked for it.
MANAGED_IDENTITY_CLIENT_ID=
AZURE_CLIENT_CERTIFICATE_PATH=
# Kubernetes workload identity instead of a managed identity: the token file the platform writes.
AZURE_FEDERATED_TOKEN_FILE=

# Product name shown to customers.
PRODUCT_NAME=HiCRM

# Fabric capacity (F SKU) that hosts customer workspaces. Required in cli/sp mode unless you adopt workspaces.
# The platform identity needs Contributor (or Admin) rights on this capacity.
FABRIC_CAPACITY_ID=

# Prefix for customer workspace names, for example saas-fabrikam-1a2b.
FABRIC_WORKSPACE_PREFIX=saas-

# Per-customer service accounts ("fabrikamsa"): one service principal per customer, Admin of that workspace only.
#   required  = never use the shared platform identity for customer work (production default)
#   preferred = fall back to the platform identity, with a warning, until the account exists (development default)
#   off       = the platform identity does everything
TENANT_IDENTITY_MODE=
# true = the platform creates service accounts itself. Needs the Microsoft Graph application permission
# Application.ReadWrite.OwnedBy on the platform app (scripts/bootstrap-identities.ps1 -GrantPlatformAppCreation).
TENANT_IDENTITY_AUTO_CREATE=false
# The credential the platform gives the service accounts it creates: federated (they trust the managed identity
# above; needs MANAGED_IDENTITY_OBJECT_ID, its object ID) or certificate (a self-signed certificate, kept encrypted).
# Default: federated with a managed identity, certificate otherwise.
TENANT_CREDENTIAL=
MANAGED_IDENTITY_OBJECT_ID=
# Only if the Fabric tenant setting "Service principals can use Fabric APIs" is limited to a security group.
FABRIC_SP_GROUP_ID=

# Where the customers' service account credentials live: file (encrypted with SECRETS_KEY) | keyvault | memory
# (tests). Default: file in live development, keyvault in production. SECRETS_KEY (16+ characters) is asked for at
# start; set it in the environment only where nobody can answer.
SECRETS_PROVIDER=
# For SECRETS_PROVIDER=keyvault: https://<vault-name>.vault.azure.net (the platform identity needs get/set on secrets)
KEY_VAULT_URL=

# Optional: an Entra group (or user/service principal) added as Viewer to every customer workspace,
# so your support team can look at it in the Fabric portal. Type: Group | User | ServicePrincipal.
FABRIC_OPS_PRINCIPAL_ID=
FABRIC_OPS_PRINCIPAL_TYPE=Group

# Optional: a "golden" template workspace whose approved reports are copied into each customer workspace and
# re-pointed at the customer's own HiCRM Insights model. Use mock-template in mock mode.
FABRIC_TEMPLATE_WORKSPACE_ID=

# SESSION_SECRET signs session cookies. In development a new one is made at each start (sign-ins end when the
# server stops); production needs one in the environment (32+ characters), shared by every instance.
# ADMIN_KEY is the back-office sign-in (24+ characters, 32+ in production). "npm start" asks for it, or makes one
# for the run and shows it once. Neither belongs in this file.

# Local web server. Keep HOST on 127.0.0.1 unless ADMIN_KEY is set.
HOST=127.0.0.1
PORT=3000

# Each customer at its own address: https://<customer>.<APP_DOMAIN>, with its own logo and color. Locally,
# APP_DOMAIN=localhost gives http://fabrikam.localhost:3000 and http://contoso.localhost:3000 (browsers send
# *.localhost to this computer) and the back office at http://localhost:3000/admin. With PUBLIC_ORIGIN, it must be
# https://<APP_DOMAIN>. Empty: one address for everyone; the email domain picks the company at sign-in.
APP_DOMAIN=

# Customers building and editing their own reports (the next phase). false: customers get the standard reports the
# platform provides (the starter report or the template's), view only.
REPORT_AUTHORING=false

# The data agent's code interpreter tool (preview), which can draw charts in Python. Needs a paid F2+ or P1+ capacity
# (not a trial) and the Fabric data agent cross-geo settings. The app draws its own charts either way.
DATA_AGENT_CODE_INTERPRETER=false

# development (default) | production. Production refuses to start unless: FABRIC_AUTH_MODE=sp,
# TENANT_IDENTITY_MODE=required, PLATFORM_WORKSPACE_ACCESS=release, SECRETS_PROVIDER=keyvault, SESSION_SECRET and
# ADMIN_KEY of 32+ characters, an https PUBLIC_ORIGIN, and a real customer sign-in (or ALLOW_DEMO_SIGNIN=true).
APP_ENV=development
# The public https address (no path). Turns on Secure cookies and HSTS.
PUBLIC_ORIGIN=
# true only behind a reverse proxy you control: the client address is then read from X-Forwarded-For.
TRUST_PROXY=false
# Staging only: allows the email-only demo sign-in with APP_ENV=production.
ALLOW_DEMO_SIGNIN=false

# keep (development default) = the platform identity stays Admin of every customer workspace.
# release (production default) = after handing a workspace to the customer's service account, the platform removes
# its own role and keeps no standing access. It is re-added for one run only when a workspace moves capacity.
PLATFORM_WORKSPACE_ACCESS=

# Lifetime of report embed tokens in minutes, 5 to 60. The browser asks for a new one before it runs out.
EMBED_TOKEN_MINUTES=30

# New customers start with sample CRM data (default true in development, false in production).
SAMPLE_DATA_DEFAULT=

# Per-customer and per-user budgets, as JSON [count, milliseconds]. Defaults:
# {"signInPerIp":[20,60000],"signInPerDomain":[60,60000],"operatorSignInPerIp":[5,60000],"askPerUser":[10,60000],
#  "askPerTenant":[60,60000],"describePerTenant":[60,60000],"embedPerUser":[60,60000],"crmWritePerTenant":[300,60000],
#  "dataLoadPerTenant":[10,60000]}
RATE_LIMITS=

# How many customers provision at the same time (1 to 50). The rest wait their turn.
PROVISIONING_CONCURRENCY=4

# CRM database connection pools: at most this many customers open at once; pools idle this long are closed.
CRM_MAX_OPEN_DATABASES=100
CRM_IDLE_MINUTES=15

# Where the tenant registry, encrypted secrets and demo data live. Defaults to %LOCALAPPDATA%\fabric-saas-platform.
DATA_DIR=
