{
  "servers": {
    "fabric-local": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@microsoft/fabric-mcp@1.6.0",
        "server",
        "start",
        "--mode",
        "all",
        "--read-only"
      ]
    },
    "fabric-core": {
      "type": "http",
      "url": "https://api.fabric.microsoft.com/v1/mcp/core"
    },
    "fabric-iq": {
      "type": "http",
      "url": "https://fabriciq.svc.cloud.microsoft/v1/mcp/fabriciq",
      "headers": {
        "X-VARIANTS": "Fabric.Routing.FabricIQ.V1"
      }
    },
    "powerbi-authoring-local": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@microsoft/powerbi-modeling-mcp@1.0.0",
        "--start"
      ],
      "env": {
        "PBI_MODELING_MCP_ACCEPT_EULA": "${env:PBI_MODELING_MCP_ACCEPT_EULA}"
      }
    },
    "fabric-sql": {
      "type": "http",
      "url": "https://api.fabric.microsoft.com/v1/mcp/dataPlane/sqlEndpoint"
    },
    "azure-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@azure/mcp@4.0.0-beta.4",
        "server",
        "start",
        "--read-only"
      ]
    },
    "azure-arm-cost": {
      "type": "http",
      "url": "https://mcp.management.azure.com",
      "headers": {
        "x-mcp-toolset": "CostManagement"
      }
    },
    "microsoft-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    }
  }
}
