# Local-only material is never published.
private/
research/local/
docs/research/local/

# Secrets and credentials
*.env
.env.*
*.pfx
*.pem
*.key
credentials.*

# Tooling output
__pycache__/
*.pyc
.pytest_cache/
tmp*/
*.tmp

# The toolchain's local pack and what it copies or generates for a host (rebuilt from the lock).
# .mcp.json is the Claude Code file; Copilot CLI would also read it first, so it is never committed.
.factory/
.github/skills/
.github/common/
.claude/skills/
.claude/common/
/.mcp.json
